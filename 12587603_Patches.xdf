      <LABEL index="3" value="4th" />
      <LABEL index="4" value="5th" />
      <LABEL index="5" value="6th" />
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="z">
      <EMBEDDEDDATA mmedaddress="0xA0112" mmedelementsizebits="16" mmedrowcount="6" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <units>RPM/MPH</units>
      <decimalpl>2</decimalpl>
      <min>0.000000</min>
      <max>16.000000</max>
      <outputtype>1</outputtype>
      <MATH equation="X/4096">
        <VAR id="X" />
