  <XDFTABLE uniqueid="0x4702" flags="0x30">
    <title>Gear Ratios</title>
    <description>The PCM will calculate the target RPM based on the speed sensor and this multiplier. These multipliers can be derived from the Gear Ratio Thresholds table in the Manual Transmission calibration section.</description>
    <CATEGORYMEM index="0" category="1" />
    <CATEGORYMEM index="1" category="2" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedelementsizebits="16" mmedmajorstridebits="-32" mmedminorstridebits="0" />
